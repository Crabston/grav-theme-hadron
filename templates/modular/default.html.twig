{% extends 'layouts/modular.html.twig' %}
{% set template_name = 'modular-text' %}
{% set image = page.media.images|first %}

{% block modular_content %}
    <div class="columns {{ page.header.image_align|default('align-right') }}">
        {% if image %}
            <div class="column">
                {{ content|raw }}
            </div>
            <div class="column">
                {{ image.html|raw }}
            </div>
        {% else %}
            <div class="column" style="grid-column: 1 / -1;">
                {{ content|raw }}
            </div>
        {% endif %}
    </div>
{% endblock modular_content %}
