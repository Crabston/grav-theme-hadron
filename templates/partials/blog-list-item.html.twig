{% if page.header.hide_from_post_list != true %}
    <article class="card h-entry">
        {# show header image if set in frontmatter #}
        {% if page.header.header_image_file %}
            {% set image = page.media[page.header.header_image_file] %}
        {% elseif page.header.hero_image %}
            {% set image = page.media[page.header.hero_image] %}
        {% else %}
            {% set image = page.media.images|first %}
        {% endif %}

        {% if page.template == 'docs' and page.header.custom_hero_header_image %}
            {% set image = page.header.custom_hero_header_image %}
            <a class="card-image-docs" href="{{ page.url }}">
                <img alt="Hadron Logo" src="{{ url(image) }}" />
            </a>
        {% elseif page.template == 'blog' and page.header.custom_hero_header_image %}
            {% set image = page.header.custom_hero_header_image %}
            <a class="card-image-docs" href="{{ page.url }}">
                <img alt="Hadron Logo" src="{{ url(image) }}" />
                <hr />
                <h1>{{ page.title }}</h1>
            </a>
        {% elseif image and ((page.header.header_image is not defined) or (page.header.header_image)) %}
            <a class="card-image" href="{{ page.url }}">{{ image.cropZoom(800, 420).html|raw }}</a>
        {% endif %}

        <header class="card-header">
            <div class="card-subtitle">
                {% include 'partials/blog/date.html.twig' %}
                {% if config.plugins.readingtime.enabled %}
                    <span class="blogitem__readingtime">{% include 'partials/blog/readingtime.html.twig' %}</span>
                {% endif %}
            </div>
            <div class="card-title">
                {% include 'partials/blog/title.html.twig' with {title_level: 'h3'} %}
            </div>
        </header>
        <div class="card-body">
            {% if page.header.subtitle %}
                {{ page.header.subtitle|raw }}
            {% elseif page.summary != page.content %}
                {# only show summary content without styles #}
                {{ page.summary|striptags|raw }}
            {% else %}
                {{ page.content|raw }}
            {% endif %}
        </div>
        <footer class="card-footer">
            {% include 'partials/blog/taxonomy.html.twig' %}
        </footer>
    </article>
{% endif %}
