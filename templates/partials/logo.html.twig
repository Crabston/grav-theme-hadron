{% set logo = theme_var(mobile ? 'custom_logo_mobile' : 'custom_logo') %}
{% set logo_first = (logo is iterable and logo|length > 0) ? logo|first : null %}
{% set logo_file = logo_first.path|default(null) %}
{% set title = config.site.slug ?  config.site.slug : config.site.title %}
{% set monochrome = theme_var('monochrome-logo') ? 'invert-color' : '' %}

<a href="{{ home_url }}" class="navbar-brand" aria-label="{{ site.title }}" title="{{ site.title }}">
    {% if logo_file %}
        <img src="{{ url(logo_file) }}" alt="{{ site.title }}" class="{{ monochrome }}" />
        {% if not config.theme.hide_title %}
            <span class="title">{{ title }}</span>
        {% endif %}
    {% else %}
        {% include '@images/grav-logo.svg' ignore missing %}
    {% endif %}
</a>
