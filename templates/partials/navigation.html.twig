{% macro nav_loop(page, hide_home_menu_link, home_alias) %}
	{% import _self as macros %}
	{% for p in page.children.visible %}
		{% set active_page = (p.active or p.activeChild) ? 'active' : '' %}
		{% if theme_var('dropdown.enabled') and p.children.visible.count > 0 %}
			<li>
				<a href="{{ p.url }}" class="{{ active_page }}">
					{% if p.header.icon %}
						<i class="fa fa-{{ p.header.icon }}"></i>
					{% endif %}
					{{ p.menu }}
				</a>
				<ul>
					{{ macros.nav_loop(p) }}
				</ul>
			</li>
		{% else %}
			<li>
				<a href="{{ p.url }}" class="{{ active_page }}">
					{% if p.header.icon %}
						<i class="fa fa-{{ p.header.icon }}"></i>
					{% endif %}
					{{ p.menu }}
				</a>
			</li>
		{% endif %}
	{% endfor %}
{% endmacro %}

<ul {{ tree ? 'class="tree"' : '' }}>
	{% import _self as macros %}
	{{ macros.nav_loop(pages, hide_home_menu_link, home_alias ) }}

    {% block snipcart_cart %}
		{% if config.plugins.snipcart.enabled %}
			<li>
				{% include 'partials/snipcart_cart.html.twig' %}
				<ul>
					<li><a href="#" class="snipcart-edit-profile">Account</a></li>
					<li><a href="#" class="snipcart-user-profile">Order History</a></li>
					<li><a href="#" class="snipcart-user-logout">Logout</a></li>
				</ul>
			</li>
		{% endif %}
    {% endblock snipcart_cart %}
</ul>
